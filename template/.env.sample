# Copy to .env.local for local development. Set the same names in the Vercel
# project for Production, Preview, and Development.
#
# Local Docker Postgres from `npm run db:local`:
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/app

# local or s3
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3. Use a pooled DATABASE_URL on Vercel.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_KEY_PREFIX=
